{
  "manifest_version": 3,
  "name": "OLED Black New Tab",
  "version": "1.2",
  "description": "True OLED New Tab for Chrome with Glassmorphism Music Player",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content-main.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}